{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "ios": { "buildConfiguration": "Release" },
      "env": { "EXPO_PUBLIC_VOICE_METRICS": "true" }
    },
    "smoke": {
      "extends": "preview",
      "distribution": "internal",
      "autoIncrement": false,
      "ios": { "simulator": true, "buildConfiguration": "Release" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "ios": { "buildConfiguration": "Release" }
    }
  },
  "submit": {
    "preview": { "ios": { "appleTeamId": "45K5W4N8DG" } },
    "production": { "ios": { "appleTeamId": "45K5W4N8DG" } }
  }
}
